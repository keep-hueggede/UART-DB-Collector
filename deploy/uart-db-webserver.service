# systemd system service for the web server (webserver/target/uart-db-webserver.jar)
# on an internet server, behind a reverse proxy with HTTPS (e.g. Caddy or nginx).
# Install (as root):
#   useradd --system --home /var/www/sh.rwx-dev.de --shell /usr/sbin/nologin uartdb
#   mkdir -p /var/www/sh.rwx-dev.de && cp uart-db-webserver.jar app.config /var/www/sh.rwx-dev.de/
#   chown -R uartdb: /var/www/sh.rwx-dev.de && chmod 600 /var/www/sh.rwx-dev.de/app.config
#   cp uart-db-webserver.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now uart-db-webserver
# Logs: journalctl -u uart-db-webserver -f

[Unit]
Description=UART-DB-Webserver (REST API, Google login, PWA)
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=uartdb
WorkingDirectory=/var/www/sh.rwx-dev.de
ExecStart=/usr/bin/java -jar /var/www/sh.rwx-dev.de/uart-db-webserver.jar
Restart=always
RestartSec=10
SuccessExitStatus=143

# Hardening: read-only system, no privilege escalation
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/sh.rwx-dev.de

[Install]
WantedBy=multi-user.target
