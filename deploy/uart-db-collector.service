# systemd user service for the UART-DB-Collector on the Raspberry Pi.
# Install (no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp uart-db-collector.service ~/.config/systemd/user/
#   loginctl enable-linger $USER          # start at boot without login
#   systemctl --user daemon-reload
#   systemctl --user enable --now uart-db-collector
# Logs: tail -f ~/app/collector.log

[Unit]
Description=UART-DB-Collector (ESP32-C6 Thread receiver -> H2/MySQL)
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/app
# The Pi has no RTC: wait (max. 2 min) for NTP so measurements get correct timestamps
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do [ "$(timedatectl show -p NTPSynchronized --value)" = yes ] && exit 0; sleep 2; done; exit 0'
TimeoutStartSec=180
ExecStart=/usr/bin/java -jar %h/app/app.jar
Restart=always
RestartSec=10
SuccessExitStatus=143
# The user journal is not readable without extra groups, so log to a file
StandardOutput=append:%h/app/collector.log
StandardError=inherit

[Install]
WantedBy=default.target
