# UART-DB-Collector Konfiguration
# Kopieren nach ./app.config und anpassen. Beide Jars lesen dieselbe Datei
# und ignorieren fremde Schluessel:
#   uart-db-collector.jar (Pi):    UART.*, BUFFER.*, DB.*, SSH.*
#   uart-db-webserver.jar (Server): SERVER.*, GOOGLE.*, MAIL.*, DB.* (nur MySQL, kein H2/SSH)

# === Name in der Netzwerk-Karte - nur Collector (leer = Hostname) ===
COLLECTOR.NAME=

# === UART (ESP-C6 ThreadReceiver -> Pi) - nur Collector ===
# /dev/ttyACM0: C6 per USB am Pi (Strom + Daten, empfohlen)
# /dev/serial0: C6 an den UART-Pins (Pi pin 8/10 + GND)
UART.PORTNAME=/dev/serial0
UART.BAUD=115200

# === Lokaler Puffer - nur Collector ===
# Ist die Datenbank nicht erreichbar, landen die UART-Zeilen hier und werden
# spaeter mit ihrer Empfangszeit nachgetragen (Neuversuch alle 30 s).
BUFFER.FILE=./spool/pending.log

# === Datenbank ===
# DB.DRIVER=h2:    lokale Datei ./data/<DB.NAME>.mv.db
# DB.DRIVER=mysql: DB.HOST:DB.PORT (direkt oder ueber den SSH-Tunnel unten)
DB.DRIVER=h2
DB.HOST=localhost
DB.PORT=3306
DB.NAME=wetter
DB.USER=sa
DB.PASSWORD=
# Optional (nur MySQL): zusaetzliche JDBC-Parameter, z.B.
#   useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB.PARAMS=

# === Web-Server / Phone-App - nur Webserver ===
# Bindet standardmaessig auf alle Interfaces -> im LAN vom Phone erreichbar.
# Im Internet: SERVER.HOST=127.0.0.1 hinter einem Reverse-Proxy mit HTTPS
# und SERVER.SECURE_COOKIE=true.
SERVER.ENABLED=true
SERVER.HOST=0.0.0.0
SERVER.PORT=8080
# Statische App-Dateien; fallback ist das mitgelieferte web/ im jar.
SERVER.WEBROOT=./web
# Cookie "Secure"-Flag setzen, wenn hinter HTTPS (z.B. Reverse-Proxy/SSH-Tunnel).
SERVER.SECURE_COOKIE=false

# === Google-Login ===
# Wird bei der Ersteinrichtung im Browser eingetragen und in der Datenbank
# gespeichert (spaeter: Zahnrad -> Administration -> Server). Hier nicht mehr noetig;
# vorhandene GOOGLE.CLIENT_ID / GOOGLE.CLIENT_SECRET / GOOGLE.REDIRECT_URI
# werden beim ersten Start einmalig in die Datenbank uebernommen.

# === E-Mail an alle Admins bei neuen Konten - nur Webserver ===
# Wie GOOGLE.*: wird beim ersten Start einmalig in die Datenbank uebernommen
# (spaeter: Administration -> Server). Ohne MAIL.USER keine Mails.
# Voreinstellung Strato; Benutzer = volle E-Mail-Adresse.
#MAIL.HOST=smtp.strato.de
#MAIL.SECURITY=SSL
#MAIL.PORT=465
#MAIL.USER=wetter@example.de
#MAIL.PASSWORD=
# leer = MAIL.USER
#MAIL.FROM=

# === Sensor-Firmware-Updates - nur Collector (Pi) ===
# Neue GitHub-Releases der Sensor-Firmware werden geladen, per SHA-256
# geprueft und an den Empfaenger (ESP32-C6) uebertragen; die Sensoren
# aktualisieren sich dann selbst ueber Thread.
FIRMWARE.ENABLED=true
FIRMWARE.REPO=keep-hueggede/ESP12-BME
FIRMWARE.CHECK_HOURS=6
FIRMWARE.DIR=./firmware

# === SSH-Tunnel zur MySQL-DB auf dem Webserver - nur Collector (Pi) ===
# SSH.ENABLED=true leitet 127.0.0.1:<SSH.LOCAL_PORT> ueber den SSH-Server an
# SSH.REMOTE_HOST:SSH.REMOTE_PORT weiter; DB.HOST/DB.PORT werden dann ignoriert.
# Voraussetzung: DB.DRIVER=mysql. Details siehe README.
SSH.ENABLED=false
SSH.HOST=server.example.org
SSH.PORT=22
SSH.USER=dbuser
# publickey (empfohlen) oder password. Ohne Angabe: publickey, wenn
# SSH.PRIVATE_KEY gesetzt ist, sonst password.
SSH.AUTH=publickey
SSH.PRIVATE_KEY=~/.ssh/id_ed25519
SSH.PASSPHRASE=
SSH.PASSWORD=
# Hostkey-Pruefung; known_hosts erzeugen mit:
#   ssh-keyscan -p 22 server.example.org > ./known_hosts
SSH.KNOWN_HOSTS=./known_hosts
SSH.STRICT_HOST_KEY_CHECKING=true
# Ziel aus Sicht des SSH-Servers (meist dessen lokaler MySQL)
SSH.REMOTE_HOST=127.0.0.1
SSH.REMOTE_PORT=3306
# 0 = freien lokalen Port automatisch waehlen (empfohlen)
SSH.LOCAL_PORT=0
SSH.CONNECT_TIMEOUT=15000
